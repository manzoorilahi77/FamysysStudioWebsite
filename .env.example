# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Never put a real value in this file — scripts/check-secrets.mjs fails the build if one
# appears in anything git tracks.

# Database (MySQL 8.0). The site reads its content through this at BUILD time, and the
# admin panel and the contact form read and write it per request.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# The site's own origin, no trailing slash. Canonical URLs, the sitemap and the Open Graph
# card are all absolute, and a page cannot work out its own origin from inside a render —
# so a missing value here does not fail, it publishes localhost to a crawler. Defaults to
# https://studio.famysys.com when unset; set it for a local build or a staging host.
NEXT_PUBLIC_SITE_URL=

# Admin panel. One shared login.
#
# ESCAPE EVERY $ IN THE HASH WITH A BACKSLASH. A .env value goes through variable
# expansion, so an unescaped bcrypt hash arrives as a fragment of itself and every sign-in
# fails with a message that says nothing about why:
#   ADMIN_PASSWORD_HASH=\$2b\$12\$abc…
#
# ADMIN_PASSWORD_HASH is a bcrypt hash at cost 12 — never the password itself:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "<password>"
ADMIN_PASSWORD_HASH=

# Signs the session cookie. 32 characters minimum; the generator gives 64. Rotating it
# signs everybody out, which is also how a leaked cookie is revoked.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Which repositories the site and the panel read through: "database" or "static".
# "static" reads the TypeScript modules under src/infrastructure/content/static/ instead.
# The site also falls back to them on its own when the database cannot be reached, so
# this variable is for choosing deliberately rather than for surviving an outage.
CONTENT_SOURCE=database
