# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Never put a real value in this file — scripts/check-secrets.mjs fails the build if one
# appears in anything git tracks.

# Database (MySQL 8.0). The site reads its content through this at BUILD time, and the
# admin panel and the contact form read and write it per request.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# The site's own origin, no trailing slash. Canonical URLs, the sitemap and the Open Graph
# card are all absolute, and a page cannot work out its own origin from inside a render —
# so a missing value here does not fail, it publishes localhost to a crawler. Defaults to
# https://studio.famysys.com when unset; set it for a local build or a staging host.
NEXT_PUBLIC_SITE_URL=

# Admin panel. One shared login.
#
# ESCAPE EVERY $ IN THE HASH WITH A BACKSLASH. A .env value goes through variable
# expansion, so an unescaped bcrypt hash arrives as a fragment of itself and every sign-in
# fails with a message that says nothing about why:
#   ADMIN_PASSWORD_HASH=\$2b\$12\$abc…
#
# ADMIN_PASSWORD_HASH is a bcrypt hash at cost 12 — never the password itself:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "<password>"
ADMIN_PASSWORD_HASH=

# Signs the session cookie. 32 characters minimum; the generator gives 64. Rotating it
# signs everybody out, which is also how a leaked cookie is revoked.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Outbound mail from the contact form, sent through Microsoft Graph.
#
# WHY GRAPH: famysys.com's mail is Exchange Online and its SPF record ends in -all, so any
# third-party sender (SendGrid, Resend, a local sendmail, a Gmail app password) is rejected
# outright. SMTP AUTH on smtp.office365.com is being retired, cannot send as a shared
# mailbox and needs port 587, which shared hosts block. Graph is OAuth2 over 443 with no
# mailbox password anywhere.
#
# OFF BY DEFAULT, AND LEAVE IT OFF LOCALLY. With MAIL_ENABLED=false every enquiry is still
# stored and shown in /admin/inbox; the send is skipped. With it true, all five values
# below MAIL_FROM_NAME must be set or the server refuses to start — better than a visitor
# finding the gap. Set it true only in production (shared/.env on the server).
MAIL_ENABLED=false
# The mailbox Graph sends AS, and the From: address. Must be inside the app's
# ApplicationAccessPolicy (see docs/deployment.md).
MAIL_SENDER=
# The display name beside that address. Defaults to "Famysys Studio". Not decoration:
# without it Graph uses the mailbox's Entra display name, which is set for administration,
# and the From line is the first thing a prospective client reads.
MAIL_FROM_NAME=
# Where the "New inquiry" notification lands. Separate from MAIL_SENDER on purpose: the
# sending mailbox and the inbox people work from need not be the same one.
MAIL_NOTIFY_TO=
# From the Entra app registration: Directory (tenant) ID, Application (client) ID, and the
# client secret's VALUE (shown once) — not its Secret ID. The secret expires; the send
# starts failing that day, so diarise it. `npm run mail:check` tests all three.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Which repositories the site and the panel read through: "database" or "static".
# "static" reads the TypeScript modules under src/infrastructure/content/static/ instead.
# The site also falls back to them on its own when the database cannot be reached, so
# this variable is for choosing deliberately rather than for surviving an outage.
CONTENT_SOURCE=database

# Google Analytics 4 measurement ID. NEXT_PUBLIC_ so the browser can read it — not a
# secret, just an identifier — but it should still come from here rather than being
# written into a component. Only loads on a production build, and never under /admin;
# see src/presentation/layout/GoogleAnalytics.tsx. Leave empty to run with GA4 off.
NEXT_PUBLIC_GA_ID=
