{
  "name": "famysys-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/clean-stale-next.mjs dev && node scripts/generate-color-css.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/clean-stale-next.mjs build && node scripts/generate-color-css.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/generate-color-css.mjs --check && node scripts/check-secrets.mjs",
    "colours": "node scripts/generate-color-css.mjs",
    "check-colours": "node scripts/check-colours.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "node scripts/format-changed.mjs",
    "format:all": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:content-todo": "node scripts/generate-content-todo.mjs",
    "check-secrets": "node scripts/check-secrets.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:status": "node scripts/db-status.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "mysql2": "^3.24.3",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "jsdom": "^25.0.1",
    "lighthouse": "^13.4.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
